<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <!-- ============================================================
         GRAPHITE — explorer (console list) item style
         Subtle accent-bar selection ported from the LaunchBox SideBarView:
         a thin AccentBrush bar + translucent surface, instead of Default's
         loud full-accent fill. Content (name / count / expander) is left to
         Playnite's ContentPresenter, so the games drill-down still works.
         ============================================================ -->
    <Style x:Key="GraphiteExplorerItem" TargetType="ListBoxItem">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,1,0,1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid Height="34">
                        <Border x:Name="Bg" CornerRadius="6" Background="Transparent" />
                        <Border x:Name="AccentBar" Width="4" Height="18" HorizontalAlignment="Left"
                                CornerRadius="2" Background="{DynamicResource AccentBrush}"
                                Visibility="Collapsed" />
                        <Border Padding="14,0,12,0" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="Selector.IsSelected" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bg" Property="Background" Value="#2E000000" />
                        </MultiTrigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#59000000" />
                            <Setter TargetName="AccentBar" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ExplorerPanel}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ExplorerPanel}">
                    <Border BorderBrush="{DynamicResource PanelSeparatorBrush}"
                            d:DesignWidth="220"
                            d:DesignHeight="400">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderThickness" Value="1,0,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Settings ExplorerPanelPosition}" Value="Left">
                                        <Setter Property="BorderThickness" Value="0,0,1,0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Settings ShowPanelSeparators}" Value="False">
                                        <Setter Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel Background="{TemplateBinding Background}">
                            <DockPanel DockPanel.Dock="Top" LastChildFill="True"
                                       Margin="12,14,12,8">
                                <Button Content="r" FontFamily="Marlett"
                                        Style="{StaticResource SimpleButton}"
                                        DockPanel.Dock="Right" Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        Name="PART_ButtonClose"/>
                                <ComboBox Name="PART_SelectFields" MaxDropDownHeight="Auto"
                                          DockPanel.Dock="Left" />
                            </DockPanel>
                            <Separator Height="1" DockPanel.Dock="Top"
                                       Background="{DynamicResource PanelSeparatorBrush}"
                                       Margin="12,0,12,4" Focusable="False" SnapsToDevicePixels="True"/>
                            <ListBox Name="PART_SelectItems"
                                 DockPanel.Dock="Top" Margin="6,0,6,8"
                                 ItemContainerStyle="{StaticResource GraphiteExplorerItem}"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            </ListBox>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
