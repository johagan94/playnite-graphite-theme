<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
                    mc:Ignorable="d">

    <!-- ================================================================
         GRAPHITE - Details view (prototype v7)
           Banner : full-bleed (UniformToFill) hero band, fades to base
           Hero   : title / meta / actions, pushed lower so they read as part
                    of the banner area, centered
           Panel  : ONE flat panel; THREE EVEN modules (Details | HowLongToBeat |
                    Achievements) split by hairline rules. HLTB is a flat 3-up
                    stat row; Achievements is the interactive PlayniteAchievements
                    compact grid, width-constrained so it wraps and fits.
         ================================================================ -->

    <Style TargetType="{x:Type DetailsViewGameOverview}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DetailsViewGameOverview}">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  Style="{DynamicResource DetailsScrollViewer}"
                                  d:DesignWidth="1280" d:DesignHeight="1280"
                                  d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameDetailsIntance}"
                                  x:Name="PART_ScrollViewHost">
                        <Grid Background="{DynamicResource BackgroundBrush}">
                            <!-- Banner hero band: fills the full width, fades to base -->
                            <!-- Opacity mask removed for perf: an opacity mask forces an extra offscreen render
                                 surface every frame; the scrim Rectangle below already fades the banner to base. -->
                            <FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill"
                                       HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="580" />
                            <Rectangle VerticalAlignment="Top" Height="580" IsHitTestVisible="False">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#0015171C" Offset="0.0" />
                                        <GradientStop Color="#6615171C" Offset="0.45" />
                                        <GradientStop Color="#FF15171C" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>

                            <Grid HorizontalAlignment="Stretch" Margin="40,0,40,40">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="320"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- ============ HERO (lower, centered, over banner) ============ -->
                                <StackPanel Grid.Row="1" HorizontalAlignment="Center" MaxWidth="1100" Margin="0,0,0,8">
                                    <!-- Clear logo (ExtraMetadataLoader) when available; falls back to the text title below.
                                         No separate cover: in this library Cover often == Background (duplicates the banner). -->
                                    <ContentControl x:Name="ExtraMetadataLoader_LogoLoaderControl"
                                                    HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                                    MaxHeight="130" MaxWidth="640" Margin="0,0,0,2"
                                                    Visibility="{PluginSettings Plugin=ExtraMetadataLoader, Path=IsLogoAvailable, FallbackValue=Collapsed, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <!-- Title block wrapped so a soft radial scrim can sit behind the text for
                                         legibility over busy box art; whole block collapses when a clear logo is shown. -->
                                    <Grid HorizontalAlignment="Center">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=IsLogoAvailable, FallbackValue=False}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Rectangle IsHitTestVisible="False" Margin="-60,-22,-60,-18">
                                            <Rectangle.Fill>
                                                <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.62" RadiusY="0.72">
                                                    <GradientStop Color="#A6000000" Offset="0.0" />
                                                    <GradientStop Color="#4D000000" Offset="0.55" />
                                                    <GradientStop Color="#00000000" Offset="1.0" />
                                                </RadialGradientBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Image Name="PART_ImageIcon" MaxHeight="40" MaxWidth="40"
                                                   Margin="0,0,12,0" VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="Fant" />
                                            <TextBlock Name="PART_TextDisplayName" FontFamily="{DynamicResource FontFamily}"
                                                       FontWeight="Bold" FontSize="{DynamicResource FontSizeLargest}"
                                                       TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextBrush}">
                                                <TextBlock.Effect>
                                                    <DropShadowEffect ShadowDepth="0" BlurRadius="14" Opacity="0.85" RenderingBias="Quality"/>
                                                </TextBlock.Effect>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>

                                    <WrapPanel HorizontalAlignment="Center" Margin="0,12,0,0">
                                        <WrapPanel.Resources>
                                            <Style TargetType="Button" BasedOn="{StaticResource PropertyItemButton}" />
                                            <Style TargetType="ItemsControl"><Setter Property="VerticalAlignment" Value="Center" /></Style>
                                        </WrapPanel.Resources>
                                        <ItemsControl Name="PART_ItemsPlatforms" Margin="0,0,14,0" />
                                        <Button Name="PART_ButtonReleaseDate" Margin="0,0,14,0" VerticalAlignment="Center" />
                                        <Button Name="PART_ButtonCompletionStatus" VerticalAlignment="Center" />
                                    </WrapPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                                        <Button Name="PART_ButtonPlayAction" Width="160" Height="44" Style="{DynamicResource PlayButton}" />
                                        <Button Name="PART_ButtonContextAction" Width="150" Height="44" Margin="10,0,0,0" />
                                        <Button Name="PART_ButtonMoreActions" Content="{DynamicResource LOCMoreAction}"
                                                Width="120" Height="44" Margin="10,0,0,0" />
                                        <Button x:Name="PART_ButtonEditGame" Margin="10,0,0,0" Height="44" Width="44" Focusable="False"
                                                Content="&#xeded;" FontFamily="{DynamicResource FontIcoFont}" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- ============ ONE FLAT PANEL (3 even modules) ============ -->
                                <Border Grid.Row="2" HorizontalAlignment="Stretch" MaxWidth="1500" Margin="0,24,0,0"
                                        Background="{DynamicResource DarkBackgroundBrush}"
                                        BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                                        CornerRadius="12">
                                    <Border.Resources>
                                        <Style x:Key="ModuleHeader" TargetType="TextBlock">
                                            <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
                                            <Setter Property="FontWeight" Value="Medium" />
                                            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
                                            <Setter Property="Margin" Value="0,0,0,16" />
                                        </Style>
                                        <!-- Recessed module panel: a darker inset card on the elevated panel,
                                             so Details / HowLongToBeat / Achievements each read as their own panel. -->
                                        <Style x:Key="ModuleCard" TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="CornerRadius" Value="8" />
                                            <Setter Property="Padding" Value="20,18" />
                                            <Setter Property="ClipToBounds" Value="True" />
                                            <Setter Property="VerticalAlignment" Value="Stretch" />
                                        </Style>
                                    </Border.Resources>
                                    <StackPanel>
                                        <!-- Description -->
                                        <StackPanel Name="PART_ElemDescription" Margin="26,22">
                                            <TextBlock Text="{DynamicResource LOCGameDescriptionTitle}" Style="{StaticResource ModuleHeader}" />
                                            <HtmlTextView Name="PART_HtmlDescription"
                                                          HtmlFontSize="{DynamicResource FontSize}"
                                                          HtmlFontFamily="{DynamicResource FontFamily}"
                                                          HtmlForeground="{DynamicResource TextColor}"
                                                          LinkForeground="{DynamicResource GlyphColor}"
                                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                          ScrollViewer.VerticalScrollBarVisibility="Disabled"/>
                                        </StackPanel>

                                        <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" />

                                        <!-- ===== THREE MODULE PANELS (recessed cards) ===== -->
                                        <Grid Margin="22,8,22,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Details -->
                                            <Border Grid.Column="0" Style="{StaticResource ModuleCard}">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="DETAILS" Style="{StaticResource ModuleHeader}" />
                                                <GridEx ColumnCount="2" StarColumns="1" RowCount="9" AutoLayoutColumns="2">
                                                    <Grid.Resources>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}" />
                                                        <Style TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
                                                            <Setter Property="Margin" Value="0,3,16,3" />
                                                            <Setter Property="VerticalAlignment" Value="Top" />
                                                            <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
                                                        </Style>
                                                        <Style TargetType="ItemsControl"><Setter Property="VerticalAlignment" Value="Center" /></Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource PropertyItemButton}" />
                                                    </Grid.Resources>
                                                    <Label Name="PART_ElemDevelopers" Content="{DynamicResource LOCDeveloperLabel}" />
                                                    <ItemsControl Name="PART_ItemsDevelopers" />
                                                    <Label Name="PART_ElemPublishers" Content="{DynamicResource LOCPublisherLabel}" />
                                                    <ItemsControl Name="PART_ItemsPublishers" />
                                                    <Label Name="PART_ElemGenres" Content="{DynamicResource LOCGenreLabel}" />
                                                    <ItemsControl Name="PART_ItemsGenres" />
                                                    <Label Name="PART_ElemSeries" Content="{DynamicResource LOCSeriesLabel}" />
                                                    <ItemsControl Name="PART_ItemsSeries" />
                                                    <Label Name="PART_ElemSource" Content="{DynamicResource LOCSourceLabel}" />
                                                    <Button Name="PART_ButtonSource" VerticalAlignment="Center" />
                                                    <Label Name="PART_ElemPlayTime" Content="{DynamicResource LOCTimePlayed}" />
                                                    <TextBlock Name="PART_TextPlayTime" VerticalAlignment="Center" />
                                                    <Label Name="PART_ElemLastPlayed" Content="{DynamicResource LOCLastPlayed}" />
                                                    <TextBlock Name="PART_TextLastActivity" VerticalAlignment="Center" />
                                                    <Label Name="PART_ElemCommunityScore" Content="{DynamicResource LOCCommunityScore}" />
                                                    <TextBlock Name="PART_TextCommunityScore" VerticalAlignment="Center" Style="{DynamicResource TextBlockGameScore}" />
                                                    <Label Name="PART_ElemCriticScore" Content="{DynamicResource LOCCriticScore}" />
                                                    <TextBlock Name="PART_TextCriticScore" VerticalAlignment="Center" Style="{DynamicResource TextBlockGameScore}" />
                                                </GridEx>
                                            </StackPanel>
                                            </Border>

                                            <!-- HowLongToBeat (RIGHT): graphite progress bar + flat 3-up times -->
                                            <Border Grid.Column="4">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource ModuleCard}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ElementName=HltbMainStory, Path=Visibility}" Value="Visible"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding ElementName=HltbMainExtra, Path=Visibility}" Value="Visible"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding ElementName=HltbCompletionist, Path=Visibility}" Value="Visible"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            <StackPanel x:Name="HltbSection" VerticalAlignment="Center">
                                                <TextBlock Text="HOW LONG TO BEAT" Style="{StaticResource ModuleHeader}" />
                                                <!-- Helium-style HLTB progress bar, hosted with a graphite rounded track -->
                                                <Border CornerRadius="4" ClipToBounds="True" Height="20" Margin="0,0,0,16"
                                                        Background="{DynamicResource BackgroundBrush}">
                                                    <ContentControl x:Name="HowLongToBeat_PluginProgressBar"
                                                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                                </Border>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.Resources>
                                                        <Style x:Key="HltbStat" TargetType="StackPanel"><Setter Property="HorizontalAlignment" Value="Center" /></Style>
                                                        <Style x:Key="HltbIcon" TargetType="Path">
                                                            <Setter Property="Width" Value="15" /><Setter Property="Height" Value="15" />
                                                            <Setter Property="Stretch" Value="Uniform" /><Setter Property="Fill" Value="{DynamicResource TextBrushDarker}" />
                                                            <Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Margin" Value="0,0,6,0" />
                                                        </Style>
                                                        <Style x:Key="HltbLabel" TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
                                                            <Setter Property="VerticalAlignment" Value="Center" />
                                                            <Setter Property="FontSize" Value="9" /><Setter Property="TextWrapping" Value="NoWrap" />
                                                        </Style>
                                                        <Style x:Key="HltbValue" TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                            <Setter Property="FontSize" Value="20" /><Setter Property="FontWeight" Value="Bold" />
                                                            <Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="Margin" Value="0,8,0,0" />
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Text}" Value="-"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Resources>
                                                    <StackPanel Grid.Column="0" Style="{StaticResource HltbStat}" Visibility="{Binding ElementName=HltbMainStory, Path=Visibility}">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <Path Style="{StaticResource HltbIcon}" Data="M12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22C6.47,22 2,17.5 2,12A10,10 0 0,1 12,2M12.5,7V12.25L17,14.92L16.25,16.15L11,13V7H12.5Z" />
                                                            <TextBlock Text="MAIN STORY" Style="{StaticResource HltbLabel}" />
                                                        </StackPanel>
                                                        <TextBlock x:Name="HltbMainStory" Style="{StaticResource HltbValue}"
                                                                   Text="{PluginSettings Plugin=HowLongToBeat, Path=MainStoryFormat, FallbackValue='-'}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Style="{StaticResource HltbStat}" Visibility="{Binding ElementName=HltbMainExtra, Path=Visibility}">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <Path Style="{StaticResource HltbIcon}" Data="M14.47 15.08L11 13V7H12.5V12.25L15.58 14.08C15.17 14.36 14.79 14.7 14.47 15.08M13.08 19.92C12.72 19.97 12.37 20 12 20C7.58 20 4 16.42 4 12S7.58 4 12 4 20 7.58 20 12C20 12.37 19.97 12.72 19.92 13.08C20.61 13.18 21.25 13.4 21.84 13.72C21.94 13.16 22 12.59 22 12C22 6.5 17.5 2 12 2S2 6.5 2 12C2 17.5 6.47 22 12 22C12.59 22 13.16 21.94 13.72 21.84C13.4 21.25 13.18 20.61 13.08 19.92M18 15V18H15V20H18V23H20V20H23V18H20V15H18Z" />
                                                            <TextBlock Text="MAIN + EXTRAS" Style="{StaticResource HltbLabel}" />
                                                        </StackPanel>
                                                        <TextBlock x:Name="HltbMainExtra" Style="{StaticResource HltbValue}"
                                                                   Text="{PluginSettings Plugin=HowLongToBeat, Path=MainExtraFormat, FallbackValue='-'}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Style="{StaticResource HltbStat}" Visibility="{Binding ElementName=HltbCompletionist, Path=Visibility}">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <Path Style="{StaticResource HltbIcon}" Data="M7,2H17V4H20V8C20,10.21 18.21,12 16,12C15.74,12 15.46,11.97 15.21,11.92C14.42,13.21 13.32,14.14 12,14.7V18H15V20H9V18H12V14.7C10.68,14.14 9.58,13.21 8.79,11.92C8.54,11.97 8.26,12 8,12C5.79,12 4,10.21 4,8V4H7V2M5,5V8C5,9.66 6.34,11 8,11C8.04,11 8.08,11 8.12,11C7.41,9.7 7,8.39 7,7V5H5M17,5V7C17,8.39 16.59,9.7 15.88,11C15.92,11 15.96,11 16,11C17.66,11 19,9.66 19,8V5H17Z" />
                                                            <TextBlock Text="COMPLETIONIST" Style="{StaticResource HltbLabel}" />
                                                        </StackPanel>
                                                        <TextBlock x:Name="HltbCompletionist" Style="{StaticResource HltbValue}"
                                                                   Text="{PluginSettings Plugin=HowLongToBeat, Path=CompletionistFormat, FallbackValue='-'}" />
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                            </Border>

                                            <!-- Achievements (MIDDLE): custom badge grid via PlayniteAchievements Modern Bindings
                                                 (PluginSettings root). Bounded wrapping grid; hover a badge for name + rarity +
                                                 description ("how to beat"). -->
                                            <Border Grid.Column="2">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource ModuleCard}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=PlayniteAchievements, Path=HasAchievements, FallbackValue=False}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <DockPanel x:Name="AchSection">
                                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="ACHIEVEMENTS" Style="{StaticResource ModuleHeader}" Margin="0" />
                                                            <TextBlock Style="{StaticResource ModuleHeader}" Margin="10,0,0,0"
                                                                       Text="{PluginSettings Plugin=PlayniteAchievements, Path=UnlockedCount, FallbackValue=''}" />
                                                            <TextBlock Style="{StaticResource ModuleHeader}" Margin="3,0,0,0" Text="/" />
                                                            <TextBlock Style="{StaticResource ModuleHeader}" Margin="3,0,0,0"
                                                                       Text="{PluginSettings Plugin=PlayniteAchievements, Path=AchievementCount, FallbackValue=''}" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                    <!-- Virtualized ~8-wide badge grid: only on-screen badges render, which fixes the
                                                         "render every badge on each game-select" perf hit. Bounded to ~3 rows, scroll for more.
                                                         Uses the achievements plugin's bundled VirtualizingWrapPanel. -->
                                                    <!-- Path=AchievementDefaultOrder = the provider's natural order (the sequence achievements are
                                                         defined in). Unlock-time sorts only reorder UNLOCKED items, so on 0%-complete games they look
                                                         unsorted; provider order reads intentional on every game. -->
                                                    <ListBox ItemsSource="{PluginSettings Plugin=PlayniteAchievements, Path=AchievementDefaultOrder}"
                                                             MaxHeight="172" BorderThickness="0" Background="Transparent" Padding="0"
                                                             ScrollViewer.CanContentScroll="True"
                                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                                        <ListBox.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <vwp:VirtualizingWrapPanel Orientation="Horizontal" SpacingMode="None" />
                                                            </ItemsPanelTemplate>
                                                        </ListBox.ItemsPanel>
                                                        <ListBox.ItemContainerStyle>
                                                            <Style TargetType="ListBoxItem">
                                                                <Setter Property="Margin" Value="0,0,4,4" />
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </ListBox.ItemContainerStyle>
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Width="50" Height="50" CornerRadius="4"
                                                                        ClipToBounds="True" Background="{DynamicResource ElevatedSurfaceBrush}"
                                                                        ToolTipService.InitialShowDelay="250" ToolTipService.ShowDuration="20000">
                                                                    <Border.ToolTip>
                                                                        <ToolTip MaxWidth="340">
                                                                            <StackPanel>
                                                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" TextWrapping="Wrap"
                                                                                           Foreground="{DynamicResource TextBrush}" />
                                                                                <TextBlock Text="{Binding RarityText}" FontSize="11" Margin="0,3,0,0"
                                                                                           Foreground="{DynamicResource TextBrushDarker}" />
                                                                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,7,0,0"
                                                                                           Foreground="{DynamicResource TextBrushDarker}" />
                                                                            </StackPanel>
                                                                        </ToolTip>
                                                                    </Border.ToolTip>
                                                                    <Grid>
                                                                        <!-- Colour base: shown when unlocked, and a safe fallback if the grayscale bind fails -->
                                                                        <Image x:Name="AchColor" Source="{Binding Icon}" Stretch="UniformToFill"
                                                                               RenderOptions.BitmapScalingMode="Fant" />
                                                                        <!-- True grayscale (default = unobtained); collapsed when unlocked so colour shows through -->
                                                                        <Image x:Name="AchGray" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="Fant">
                                                                            <Image.Source>
                                                                                <FormatConvertedBitmap DestinationFormat="Gray8" Source="{Binding Icon}" />
                                                                            </Image.Source>
                                                                        </Image>
                                                                    </Grid>
                                                                </Border>
                                                                <DataTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding Unlocked}" Value="True">
                                                                        <Setter TargetName="AchGray" Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </DataTemplate.Triggers>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </DockPanel>
                                            </Border>
                                        </Grid>

                                        <Rectangle Height="1" Fill="{DynamicResource DividerBrush}"
                                                   Visibility="{Binding ElementName=PART_ElemNotes, Path=Visibility}" />
                                        <StackPanel Name="PART_ElemNotes" Margin="26,22">
                                            <TextBlock Text="{DynamicResource LOCNotesLabel}" Style="{StaticResource ModuleHeader}" />
                                            <TextBox Name="PART_TextNotes" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                                     AcceptsReturn="True" TextWrapping="Wrap" Margin="-1,0,-1,0" Padding="0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
