<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <!-- ================================================================
         GRAPHITE - Details view (prototype v5 - centered hero + one panel)
           Banner : own hero band, Uniform so the whole image shows, fades to base
           Hero   : centered cover + title + meta + actions
           Panel  : ONE flat panel; modular sections (Description, then
                    Details | HowLongToBeat | Achievements) split by hairline rules
         ================================================================ -->

    <Style TargetType="{x:Type DetailsViewGameOverview}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DetailsViewGameOverview}">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  Style="{DynamicResource DetailsScrollViewer}"
                                  d:DesignWidth="1280" d:DesignHeight="1280"
                                  d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameDetailsIntance}"
                                  x:Name="PART_ScrollViewHost">
                        <Grid Background="{DynamicResource BackgroundBrush}">
                            <!-- Banner hero band (whole image visible, fades to base) -->
                            <FadeImage x:Name="PART_ImageBackground" Stretch="Uniform"
                                       HorizontalAlignment="Center" VerticalAlignment="Top" Height="430">
                                <FadeImage.ImageOpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="Black" Offset="0.0" />
                                        <GradientStop Color="Black" Offset="0.45" />
                                        <GradientStop Color="Transparent" Offset="1.0" />
                                    </LinearGradientBrush>
                                </FadeImage.ImageOpacityMask>
                            </FadeImage>
                            <Rectangle VerticalAlignment="Top" Height="430" IsHitTestVisible="False">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#0015171C" Offset="0.0" />
                                        <GradientStop Color="#8815171C" Offset="0.55" />
                                        <GradientStop Color="#FF15171C" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>

                            <Grid HorizontalAlignment="Stretch" Margin="40,0,40,40">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="{Settings CalculatedGameDetailsIndentation}"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- ============ CENTERED HERO ============ -->
                                <StackPanel Grid.Row="1" HorizontalAlignment="Center" MaxWidth="1100"
                                            Margin="0,16,0,8">
                                    <Image Name="PART_ImageCover" MaxHeight="200" Stretch="Uniform"
                                           HorizontalAlignment="Center" Margin="0,0,0,18"
                                           RenderOptions.BitmapScalingMode="Fant" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Image Name="PART_ImageIcon" MaxHeight="40" MaxWidth="40"
                                               Margin="0,0,12,0" VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="Fant" />
                                        <TextBlock Name="PART_TextDisplayName" FontFamily="{DynamicResource FontFamily}"
                                                   FontWeight="Bold" FontSize="{DynamicResource FontSizeLargest}"
                                                   TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextBrush}">
                                            <TextBlock.Effect>
                                                <DropShadowEffect ShadowDepth="2" BlurRadius="10" Opacity="0.7" RenderingBias="Quality"/>
                                            </TextBlock.Effect>
                                        </TextBlock>
                                    </StackPanel>

                                    <WrapPanel HorizontalAlignment="Center" Margin="0,12,0,0">
                                        <WrapPanel.Resources>
                                            <Style TargetType="Button" BasedOn="{StaticResource PropertyItemButton}" />
                                            <Style TargetType="ItemsControl">
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                            </Style>
                                        </WrapPanel.Resources>
                                        <ItemsControl Name="PART_ItemsPlatforms" Margin="0,0,14,0" />
                                        <Button Name="PART_ButtonReleaseDate" Margin="0,0,14,0" VerticalAlignment="Center" />
                                        <Button Name="PART_ButtonCompletionStatus" VerticalAlignment="Center" />
                                    </WrapPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                                        <Button Name="PART_ButtonPlayAction" Width="160" Height="44" Style="{DynamicResource PlayButton}" />
                                        <Button Name="PART_ButtonContextAction" Width="150" Height="44" Margin="10,0,0,0" />
                                        <Button Name="PART_ButtonMoreActions" Content="{DynamicResource LOCMoreAction}"
                                                Width="120" Height="44" Margin="10,0,0,0" />
                                        <Button x:Name="PART_ButtonEditGame" Margin="10,0,0,0" Height="44" Width="44" Focusable="False"
                                                Content="&#xeded;" FontFamily="{DynamicResource FontIcoFont}" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- ============ ONE FLAT PANEL (modular) ============ -->
                                <Border Grid.Row="2" HorizontalAlignment="Center" MaxWidth="1400" Margin="0,24,0,0"
                                        Background="{DynamicResource DarkBackgroundBrush}"
                                        BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                                        CornerRadius="12">
                                    <Border.Resources>
                                        <Style x:Key="ModuleHeader" TargetType="TextBlock">
                                            <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
                                            <Setter Property="FontWeight" Value="Medium" />
                                            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
                                            <Setter Property="Margin" Value="0,0,0,14" />
                                        </Style>
                                    </Border.Resources>
                                    <StackPanel>
                                        <!-- Description module -->
                                        <StackPanel Name="PART_ElemDescription" Margin="26,22,26,22">
                                            <TextBlock Text="{DynamicResource LOCGameDescriptionTitle}" Style="{StaticResource ModuleHeader}" />
                                            <HtmlTextView Name="PART_HtmlDescription"
                                                          HtmlFontSize="{DynamicResource FontSize}"
                                                          HtmlFontFamily="{DynamicResource FontFamily}"
                                                          HtmlForeground="{DynamicResource TextColor}"
                                                          LinkForeground="{DynamicResource GlyphColor}"
                                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                          ScrollViewer.VerticalScrollBarVisibility="Disabled"/>
                                        </StackPanel>

                                        <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" />

                                        <!-- Modules row: Details | HowLongToBeat | Achievements -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" MinWidth="260" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Details -->
                                            <StackPanel Grid.Column="0" Margin="26,22" VerticalAlignment="Top">
                                                <TextBlock Text="DETAILS" Style="{StaticResource ModuleHeader}" />
                                                <GridEx ColumnCount="2" StarColumns="1" RowCount="9" AutoLayoutColumns="2">
                                                    <Grid.Resources>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}" />
                                                        <Style TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
                                                            <Setter Property="Margin" Value="0,3,16,3" />
                                                            <Setter Property="VerticalAlignment" Value="Top" />
                                                            <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
                                                        </Style>
                                                        <Style TargetType="ItemsControl">
                                                            <Setter Property="VerticalAlignment" Value="Center" />
                                                        </Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource PropertyItemButton}" />
                                                    </Grid.Resources>
                                                    <Label Name="PART_ElemDevelopers" Content="{DynamicResource LOCDeveloperLabel}" />
                                                    <ItemsControl Name="PART_ItemsDevelopers" />
                                                    <Label Name="PART_ElemPublishers" Content="{DynamicResource LOCPublisherLabel}" />
                                                    <ItemsControl Name="PART_ItemsPublishers" />
                                                    <Label Name="PART_ElemGenres" Content="{DynamicResource LOCGenreLabel}" />
                                                    <ItemsControl Name="PART_ItemsGenres" />
                                                    <Label Name="PART_ElemSeries" Content="{DynamicResource LOCSeriesLabel}" />
                                                    <ItemsControl Name="PART_ItemsSeries" />
                                                    <Label Name="PART_ElemSource" Content="{DynamicResource LOCSourceLabel}" />
                                                    <Button Name="PART_ButtonSource" VerticalAlignment="Center" />
                                                    <Label Name="PART_ElemPlayTime" Content="{DynamicResource LOCTimePlayed}" />
                                                    <TextBlock Name="PART_TextPlayTime" VerticalAlignment="Center" />
                                                    <Label Name="PART_ElemLastPlayed" Content="{DynamicResource LOCLastPlayed}" />
                                                    <TextBlock Name="PART_TextLastActivity" VerticalAlignment="Center" />
                                                    <Label Name="PART_ElemCommunityScore" Content="{DynamicResource LOCCommunityScore}" />
                                                    <TextBlock Name="PART_TextCommunityScore" VerticalAlignment="Center" Style="{DynamicResource TextBlockGameScore}" />
                                                    <Label Name="PART_ElemCriticScore" Content="{DynamicResource LOCCriticScore}" />
                                                    <TextBlock Name="PART_TextCriticScore" VerticalAlignment="Center" Style="{DynamicResource TextBlockGameScore}" />
                                                </GridEx>
                                            </StackPanel>

                                            <Rectangle Grid.Column="1" Width="1" Fill="{DynamicResource DividerBrush}"
                                                       VerticalAlignment="Stretch" Margin="0,14"
                                                       Visibility="{Binding ElementName=HltbSection, Path=Visibility}" />

                                            <!-- HowLongToBeat -->
                                            <StackPanel x:Name="HltbSection" Grid.Column="2" Margin="26,22" VerticalAlignment="Top">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ElementName=HltbMainStory, Path=Visibility}" Value="Visible">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ElementName=HltbMainExtra, Path=Visibility}" Value="Visible">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ElementName=HltbCompletionist, Path=Visibility}" Value="Visible">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock Text="HOW LONG TO BEAT" Style="{StaticResource ModuleHeader}" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.Resources>
                                                        <Style x:Key="HltbTile" TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
                                                            <Setter Property="CornerRadius" Value="8" />
                                                            <Setter Property="Padding" Value="14,12" />
                                                            <Setter Property="MinWidth" Value="86" />
                                                        </Style>
                                                        <Style x:Key="HltbIcon" TargetType="Path">
                                                            <Setter Property="Width" Value="20" /><Setter Property="Height" Value="20" />
                                                            <Setter Property="Stretch" Value="Uniform" />
                                                            <Setter Property="Fill" Value="{DynamicResource TextBrushDarker}" />
                                                            <Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="Margin" Value="0,0,0,8" />
                                                        </Style>
                                                        <Style x:Key="HltbLabel" TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
                                                            <Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="Margin" Value="0,0,0,4" />
                                                            <Setter Property="FontSize" Value="9" /><Setter Property="TextWrapping" Value="NoWrap" />
                                                        </Style>
                                                        <Style x:Key="HltbValue" TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                            <Setter Property="FontSize" Value="16" /><Setter Property="FontWeight" Value="Bold" />
                                                            <Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Text}" Value="-">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Resources>
                                                    <Border Grid.Column="0" Style="{StaticResource HltbTile}">
                                                        <StackPanel HorizontalAlignment="Center">
                                                            <Path Style="{StaticResource HltbIcon}" Data="M18,2H6C4.9,2 4,2.9 4,4V20C4,21.1 4.9,22 6,22H18C19.1,22 20,21.1 20,20V4C20,2.9 19.1,2 18,2M18,20H6V4H7V12L10,9.5L13,12V4H18V20Z" />
                                                            <TextBlock Text="MAIN STORY" Style="{StaticResource HltbLabel}" />
                                                            <TextBlock x:Name="HltbMainStory" Style="{StaticResource HltbValue}"
                                                                       Text="{PluginSettings Plugin=HowLongToBeat, Path=MainStoryFormat, FallbackValue='-'}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Grid.Column="2" Style="{StaticResource HltbTile}">
                                                        <StackPanel HorizontalAlignment="Center">
                                                            <Path Style="{StaticResource HltbIcon}" Data="M3,5H21V7H3V5M3,11H21V13H3V11M3,17H15V19H3V17M19,15V19H17V21H19V23H21V21H23V19H21V15H19Z" />
                                                            <TextBlock Text="MAIN + EXTRAS" Style="{StaticResource HltbLabel}" />
                                                            <TextBlock x:Name="HltbMainExtra" Style="{StaticResource HltbValue}"
                                                                       Text="{PluginSettings Plugin=HowLongToBeat, Path=MainExtraFormat, FallbackValue='-'}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Grid.Column="4" Style="{StaticResource HltbTile}">
                                                        <StackPanel HorizontalAlignment="Center">
                                                            <Path Style="{StaticResource HltbIcon}" Data="M7,2H17V4H20V8C20,10.21 18.21,12 16,12C15.74,12 15.46,11.97 15.21,11.92C14.42,13.21 13.32,14.14 12,14.7V18H15V20H9V18H12V14.7C10.68,14.14 9.58,13.21 8.79,11.92C8.54,11.97 8.26,12 8,12C5.79,12 4,10.21 4,8V4H7V2M5,5V8C5,9.66 6.34,11 8,11C8.04,11 8.08,11 8.12,11C7.41,9.7 7,8.39 7,7V5H5M17,5V7C17,8.39 16.59,9.7 15.88,11C15.92,11 15.96,11 16,11C17.66,11 19,9.66 19,8V5H17Z" />
                                                            <TextBlock Text="COMPLETIONIST" Style="{StaticResource HltbLabel}" />
                                                            <TextBlock x:Name="HltbCompletionist" Style="{StaticResource HltbValue}"
                                                                       Text="{PluginSettings Plugin=HowLongToBeat, Path=CompletionistFormat, FallbackValue='-'}" />
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </StackPanel>

                                            <Rectangle Grid.Column="3" Width="1" Fill="{DynamicResource DividerBrush}"
                                                       VerticalAlignment="Stretch" Margin="0,14"
                                                       Visibility="{Binding ElementName=AchSection, Path=Visibility}" />

                                            <!-- Achievements -->
                                            <StackPanel x:Name="AchSection" Grid.Column="4" Margin="26,22" VerticalAlignment="Top">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=PlayniteAchievements, Path=HasData, FallbackValue=False}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock Text="{DynamicResource LOCSuccessStoryAchievements}" Style="{StaticResource ModuleHeader}" />
                                                <ContentControl x:Name="PlayniteAchievements_PluginCompactList"
                                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Notes module -->
                                        <Rectangle Height="1" Fill="{DynamicResource DividerBrush}"
                                                   Visibility="{Binding ElementName=PART_ElemNotes, Path=Visibility}" />
                                        <StackPanel Name="PART_ElemNotes" Margin="26,22">
                                            <TextBlock Text="{DynamicResource LOCNotesLabel}" Style="{StaticResource ModuleHeader}" />
                                            <TextBox Name="PART_TextNotes" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                                     AcceptsReturn="True" TextWrapping="Wrap" Margin="-1,0,-1,0" Padding="0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
